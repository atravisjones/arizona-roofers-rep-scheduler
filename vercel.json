{
  "functions": {
    "api/geocode-sweep.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/geocode-sweep",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/production-map", "destination": "/production-map.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
